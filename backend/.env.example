# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/ticket_booking

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Seat Hold TTL (default, can be overridden per event)
DEFAULT_HOLD_TTL_MINUTES=10

# Waitlist Offer TTL
WAITLIST_OFFER_TTL_MINUTES=15

# Resend (Email)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=tickets@yourdomain.com

# Frontend URL (for CORS and waitlist links)
FRONTEND_URL=http://localhost:5173

# Scheduler interval (seconds)
SCHEDULER_INTERVAL_SECONDS=30
